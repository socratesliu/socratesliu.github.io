---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Giscus from '../components/Giscus.astro';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { data } = post;

// Astro 7 中渲染正文需要显式调用 render()
const { Content } = await render(post);

const formattedDate = data.pubDate.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={data.title} description={data.description} isArticle>
  <article>
    <header class="post-header">
      <h1>{data.title}</h1>
      <div class="post-meta">
        <time datetime={data.pubDate.toISOString()}>{formattedDate}</time>
        {
          data.updatedDate && (
            <span>
              更新于{' '}
              <time datetime={data.updatedDate.toISOString()}>
                {data.updatedDate.toLocaleDateString('zh-CN', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </time>
            </span>
          )
        }
        {
          data.tags.length > 0 && (
            <span class="tag-list">
              {data.tags.map((tag) => (
                <a class="tag" href={`/tags/${encodeURIComponent(tag)}/`}>
                  {tag}
                </a>
              ))}
            </span>
          )
        }
      </div>
    </header>

    <div class="post-content">
      <Content />
    </div>
  </article>

  <Giscus />
</BaseLayout>
