---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  isArticle?: boolean;
  image?: string;
}

const { title, description, isArticle = false, image } = Astro.props;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <BaseHead title={title} description={description} isArticle={isArticle} image={image} />
    <script is:inline>
      // 在首屏渲染前同步应用主题,避免深色模式下出现白色闪烁。
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var theme =
            stored === 'light' || stored === 'dark'
              ? stored
              : window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light';
          document.documentElement.dataset.theme = theme;
        } catch (e) {
          // localStorage 不可用时退回系统偏好
          document.documentElement.dataset.theme = window.matchMedia('(prefers-color-scheme: dark)')
            .matches
            ? 'dark'
            : 'light';
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到主要内容</a>
    <Header />
    <main class="site-main" id="main">
      <div class="container">
        <slot />
      </div>
    </main>
    <Footer />
  </body>
</html>
