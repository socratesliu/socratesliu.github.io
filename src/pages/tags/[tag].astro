---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => import.meta.env.PROD ? !data.draft : true);

  // 收集所有标签,统计每个标签的文章数
  const tagMap = new Map<string, { count: number; posts: typeof posts }>();

  for (const post of posts) {
    for (const tag of post.data.tags) {
      const entry = tagMap.get(tag) ?? { count: 0, posts: [] };
      entry.count += 1;
      entry.posts.push(post);
      tagMap.set(tag, entry);
    }
  }

  return Array.from(tagMap.entries()).map(([tag, { posts: tagPosts }]) => ({
    // params 需要原始(未编码)值,Astro 在生成路径与匹配时会自行做 URL 编码
    params: { tag },
    props: {
      tag,
      posts: tagPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
    },
  }));
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={`标签: ${tag}`} description={`所有标记为「${tag}」的文章`}>
  <h1>标签: {tag}</h1>

  <p class="post-meta">
    共 {posts.length} 篇文章 · <a href="/tags/">查看全部标签</a>
  </p>

  <ul class="post-list">
    {posts.map((post) => <PostCard post={post} />)}
  </ul>
</BaseLayout>
