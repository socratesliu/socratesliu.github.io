---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { data } = post;
---

<li>
  <h2 class="post-title">
    <a href={`/blog/${post.id}/`}>{data.title}</a>
  </h2>
  <div class="post-meta">
    <time datetime={data.pubDate.toISOString()}>
      {
        data.pubDate.toLocaleDateString('zh-CN', {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
        })
      }
    </time>
    {
      data.tags.length > 0 && (
        <span class="tag-list">
          {data.tags.map((tag) => (
            <a class="tag" href={`/tags/${encodeURIComponent(tag)}/`}>
              {tag}
            </a>
          ))}
        </span>
      )
    }
  </div>
  <p class="post-description">{data.description}</p>
</li>
